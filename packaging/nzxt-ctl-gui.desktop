#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Name=NZXT Control
GenericName=Cooling Control
Comment=Pump and fan curve control for NZXT Kraken
Exec=nzxt-ctl-gui
Icon=cpu
Terminal=false
Categories=System;Settings;HardwareSettings;
# Matches the app id the GUI sets (Wayland app_id / X11 WM_CLASS), so docks
# associate the running window with this entry.
StartupWMClass=nzxt-ctl-gui

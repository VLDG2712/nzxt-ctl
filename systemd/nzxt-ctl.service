[Unit]
Description=NZXT Kraken fan/pump curve control daemon
# No After=multi-user.target: the unit is WantedBy=multi-user.target, and a
# target is automatically ordered after the units it wants, so ordering this
# unit after it too is a cycle (systemd then drops jobs at boot/stop to break
# it). Default dependencies (after sysinit/basic.target) are enough: USB
# enumeration / nzxt_kraken3 binding isn't guaranteed by any target anyway,
# and the daemon retries hwmon discovery for up to 30s itself (see hwmon.rs);
# TimeoutStartSec below just needs to exceed that.

[Service]
Type=simple
ExecStart=/usr/local/bin/nzxt-ctl-daemon
TimeoutStartSec=45
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info
Environment=NZXT_CTL_CONFIG=/etc/nzxt-ctl/config.toml

# The daemon writes to /sys/class/hwmon/... which requires root.
# Consider narrowing this later via a udev rule granting a dedicated
# group write access to the specific pwm*/pwm*_enable files instead of
# running the whole daemon as root - noted as a follow-up hardening step,
# not done here since it depends on your exact udev setup.
User=root

# Sandboxing. Deliberately NOT set: ProtectKernelTunables (would make /sys
# read-only - we write pwm there), PrivateDevices (we need /dev/hidraw*,
# /dev/bus/usb for the LCD and /dev/nvidia* for nvidia-smi), and
# ProtectProc (nvidia-smi). ProtectSystem=strict leaves /dev, /proc and
# /sys writable; the socket dir comes from RuntimeDirectory.
RuntimeDirectory=nzxt-ctl
ProtectSystem=strict
# The SetMode IPC request rewrites [mode] active in the config (temp file +
# rename in the same directory, owner/group/mode preserved), so the daemon
# needs write access to its own config directory and nothing else in /etc.
ReadWritePaths=/etc/nzxt-ctl
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
